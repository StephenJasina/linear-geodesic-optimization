{
	"arguments": {
		"filename_json": [
			"graph_0.json",
			"graph_1.json",
			"graph_2.json",
			"graph_3.json",
			"graph_4.json",
			"graph_5.json",
			"graph_6.json",
			"graph_7.json",
			"graph_8.json"
		],
		"lambda_smooth": [0.005],
		"sides": [40],
		"mesh_scale": [0.5, 1.0, 1.5, 2.0],
		"coordinates_scale": [0.8],
		"hessian_anisotropy": [1.0],
		"hessian_orientation": ["hill"],
		"hessian_regularization": [0.001],
		"hessian_iterations": [5],
		"hessian_slope_correction": [true],
		"hessian_polish_maxiter": [0, null]
	},
	"groups": [
		["filename_json"],
		["mesh_scale"],
		["hessian_polish_maxiter"]
	],
	"settings": {
		"directory_data": ["..", "traffic", "reroute_link_outage"],
		"directory_output": ["toy", "routing_with_volumes", "traffic_reroute_link_outage_construct"],
		"output_format": [
			["hessian_polish_maxiter"],
			["mesh_scale"],
			["filename_json"]
		],
		"initialization": "sphere",
		"order_by": "filename_json",
		"postprocess_subtract_initialization": false,
		"postprocess": false
	}
}
