{
	"arguments": {
		"filename_json": [
			"graph_0.json",
			"graph_1.json",
			"graph_2.json",
			"graph_3.json",
			"graph_4.json",
			"graph_5.json",
			"graph_6.json",
			"graph_7.json",
			"graph_8.json"
		],
		"ricci_curvature_reweight": ["distribution"],
		"ricci_curvature_distribution_reweight_scale": [0.0, 1.0, 2.0],
		"lambda_curvature": [1.0],
		"smooth_loss_type": [
			"mvs", "mvs", "mvs", "mvs", "mvs",
			"tensor", "tensor", "tensor", "tensor", "tensor"
		],
		"lambda_smooth": [
			0.0, 0.0005, 0.002, 0.01, 0.05,
			0.0, 0.0001, 0.0005, 0.002, 0.01
		],
		"sides": [40],
		"mesh_scale": [1.0],
		"coordinates_scale": [0.8],
		"initial_radius": [80.0],
		"maxiter": [4000],
		"backend": ["torch"]
	},
	"groups": [
		["filename_json"],
		["smooth_loss_type", "lambda_smooth"],
		["ricci_curvature_distribution_reweight_scale"]
	],
	"settings": {
		"directory_data": ["..", "traffic", "reroute_link_outage"],
		"directory_output": ["toy", "routing_with_volumes", "traffic_reroute_link_outage_compare_lbfgs"],
		"output_format": [
			["smooth_loss_type", "lambda_smooth", "ricci_curvature_distribution_reweight_scale"],
			["index", "filename_json"]
		],
		"initialization": "sphere",
		"order_by": "filename_json",
		"postprocess_subtract_initialization": true,
		"postprocess": true
	}
}
